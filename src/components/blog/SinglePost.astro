---
import { Icon } from 'astro-icon/components';

import Image from '~/components/common/Image.astro';
import PostTags from '~/components/blog/Tags.astro';
import SocialShare from '~/components/common/SocialShare.astro';

import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';

import type { Post } from '~/types';

export interface Props {
  post: Post;
  url: string | URL;
}

const { post, url } = Astro.props;
---

<section class="ml-hero ml-hero-sm" style="border-bottom: 1px solid var(--ml-border)">
  <div class="ml-container-narrow">
    <article>
      <header>
        {post.category && <div class="ml-eyebrow">{post.category.title}</div>}
        <h1 class="ml-page-title" style="font-size: 44px; margin-top: 14px;">{post.title}</h1>
        <div class="ml-post-meta" style="margin-top: 20px;">
          <Icon name="tabler:clock" class="w-4 h-4 inline-block" />
          <time datetime={String(post.publishDate)}>{getFormattedDate(post.publishDate)}</time>
          {post.readingTime && <span>· {post.readingTime} min de lectura</span>}
          {post.author && <span>· {post.author}</span>}
        </div>
        <p class="ml-lead" style="margin-top: 0;">{post.excerpt}</p>
      </header>
    </article>
  </div>
</section>

<section class="ml-section" style="padding-top: 56px">
  <div class="ml-container-narrow">
    {
      post.image && (
        <div class="ml-post-image">
          <Image
            src={post.image}
            class="w-full"
            widths={[400, 900]}
            sizes="(max-width: 900px) 400px, 900px"
            alt={post.excerpt || ''}
            width={900}
            height={506}
            loading="eager"
            decoding="async"
          />
        </div>
      )
    }
    <div class="ml-prose">
      <slot />
    </div>
    <div class="mt-8 flex justify-between flex-col sm:flex-row" style="margin-top: 40px;">
      <PostTags tags={post.tags} />
      <SocialShare url={url} text={post.title} class="mt-5 sm:mt-1" />
    </div>
  </div>
</section>
