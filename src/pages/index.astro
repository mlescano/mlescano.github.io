---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import Steps from '~/components/widgets/Steps.astro';
import Features from '~/components/widgets/Features.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Martín Lescano | Responsable de Área de TI',
  ignoreTitleTemplate: true,
};

const heroNetworkImage = `
<svg viewBox="0 0 800 450" class="w-full rounded-md shadow-lg" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Red de nodos de infraestructura">
  <rect width="800" height="450" rx="16" fill="#0b0f14" />
  <g stroke="#8ace25" stroke-width="1.4" opacity="0.55">
    <line x1="120" y1="110" x2="300" y2="90" />
    <line x1="300" y1="90" x2="470" y2="150" />
    <line x1="300" y1="90" x2="260" y2="230" />
    <line x1="470" y1="150" x2="640" y2="120" />
    <line x1="470" y1="150" x2="520" y2="300" />
    <line x1="260" y1="230" x2="130" y2="300" />
    <line x1="260" y1="230" x2="420" y2="310" />
    <line x1="420" y1="310" x2="520" y2="300" />
    <line x1="520" y1="300" x2="670" y2="330" />
    <line x1="130" y1="300" x2="220" y2="380" />
    <line x1="420" y1="310" x2="360" y2="390" />
    <line x1="640" y1="120" x2="690" y2="230" />
    <line x1="690" y1="230" x2="670" y2="330" />
  </g>
  <g fill="#8ace25">
    <circle cx="120" cy="110" r="5" />
    <circle cx="300" cy="90" r="6" />
    <circle cx="470" cy="150" r="7" />
    <circle cx="640" cy="120" r="5" />
    <circle cx="260" cy="230" r="6" />
    <circle cx="690" cy="230" r="5" />
    <circle cx="130" cy="300" r="5" />
    <circle cx="420" cy="310" r="6" />
    <circle cx="520" cy="300" r="7" />
    <circle cx="670" cy="330" r="5" />
    <circle cx="220" cy="380" r="5" />
    <circle cx="360" cy="390" r="5" />
  </g>
</svg>
`;
---

<Layout metadata={metadata}>
  {/* HERO */}
  <Hero
    actions={[
      { variant: 'primary', text: 'Ver casos', href: '#proyectos' },
      { text: 'Contacto', href: '#contacto' },
    ]}
    image={heroNetworkImage}
  >
    <Fragment slot="title">
      Martín Lescano <br />
      <span class="text-primary">Responsable de Área de TI</span>
    </Fragment>

    <Fragment slot="subtitle">
      Liderazgo técnico y estrategia en infraestructura resiliente: Proxmox, Ceph y alta disponibilidad, con un
      criterio claro de soluciones deterministas y automatización donde aporta valor real.
    </Fragment>
  </Hero>

  {/* SOBRE MÍ */}
  <Content
    id="sobre-mi"
    title="Sobre mí"
    subtitle="Responsable de Área de TI en Sohipren S.A. (industria metalúrgica exportadora) desde 2021, con el objetivo de crecer hacia la dirección de áreas de TI."
    items={[
      {
        title: 'Infraestructura y virtualización',
        description:
          'Diseñé e implementé la plataforma propia sobre Proxmox VE y Ceph, en reemplazo de VMware ESXi: compra de hardware, diseño de VLAN y conectividad entre nodos, y definición de servicios con alta disponibilidad.',
      },
      {
        title: 'Backup y continuidad operativa',
        description:
          'Estrategia de backup y recuperación ante desastres con Veeam B&R y Proxmox Backup Server con réplica off-site, reduciendo de forma estimada el tiempo de restauración de ~22 horas a menos de 4 horas.',
      },
      {
        title: 'Automatización con criterio determinista',
        description:
          'Desarrollo, con asistencia de IA, aplicaciones y automatizaciones para procesos de soporte (conciliación bancaria, instalación de PCs con USMT, redirección de carpetas). Uso soluciones deterministas, e IA solo donde aporta valor.',
      },
    ]}
  />

  {/* TRAYECTORIA EN SOHIPREN: PLAN ESTRATÉGICO 2021-2026 */}
  <Steps
    id="evolucion"
    title="Plan Estratégico de TI 2021-2026"
    subtitle="Hitos ejecutados en Sohipren S.A., sobre un plan que elaboré y vengo llevando adelante año a año."
    items={[
      {
        title: '2021',
        description:
          'Actualización de S.O., infraestructura, microservicios, migración de dominio, políticas de backup, red profesional, seguridad del router, UPS para servidores y Veeam B&R.',
        icon: 'tabler:calendar-event',
      },
      {
        title: '2022',
        description:
          'Antivirus, banco de pruebas, migración de SQL, nuevo router, red del galpón, RemoteApp, seguridad de Gmail y desarrollo de scripts.',
        icon: 'tabler:calendar-event',
      },
      {
        title: '2023',
        description:
          'Docker Swarm, ERP web, GPO, red de fibra, seguridad contra dispositivos desconocidos, seguridad SSL y UPS grabado.',
        icon: 'tabler:calendar-event',
      },
      {
        title: '2024',
        description:
          'Infraestructura Proxmox, Proxmox Backup, aire acondicionado, UPS para PCs críticas, internet satelital Starlink, telefonía VoIP, desarrollo de scripts, planificación y capacitación en ciberseguridad.',
        icon: 'tabler:calendar-event',
      },
      {
        title: '2025',
        description: 'Monitoreo de servidores críticos y migración de más de 50 VMs de servidores ESXi a Proxmox.',
        icon: 'tabler:calendar-event',
      },
      {
        title: '2026',
        description:
          'Instalación de VoIP con Issabel 5, instalación de Minio, instalación de Nextcloud, digitalización de documentos de armado y prueba, estabilización y modernización de infraestructura, gestión de programas de CNC, mejora de Wi-Fi, optimización de costos en dominios y certificados, Windows 11/licencias Office, app de soporte remoto y servicio de despliegue automático de PCs.',
        icon: 'tabler:calendar-event',
      },
    ]}
  />

  {/* CASOS DOCUMENTADOS */}
  <BlogLatestPosts
    id="proyectos"
    title="Casos documentados"
    information="Problema, decisión y resultado de los proyectos de infraestructura que llevé adelante en Sohipren."
  />

  {/* EXPERIENCIA PREVIA */}
  <Steps
    title="Experiencia previa"
    subtitle="Antes de Sohipren, en roles de gestión y consultoría de IT."
    items={[
      {
        title: 'Sila Holding Industriale — IT Manager (2008–2009 y 2015–2016)',
        description:
          'Reportando a la dirección. Ahorro del 60% en costos de IT. Coordiné la implementación del ERP Protheus V.8 con Totvs.',
        icon: 'tabler:briefcase',
      },
      {
        title: 'ML Services & GFG Informática — Owner/Partner (2016–2021)',
        description:
          'Consultoría en virtualización VMware vSphere, redes, backup y seguridad. +30% de eficiencia y −40% de inactividad para clientes.',
        icon: 'tabler:briefcase',
      },
      {
        title: 'Hewlett-Packard — Information Security Consultant (2009–2011)',
        description: 'Administración de accesos para clientes. Documentación adoptada a nivel global.',
        icon: 'tabler:briefcase',
      },
    ]}
  />

  {/* FORMACIÓN */}
  <Features
    title="Formación y certificaciones"
    items={[
      {
        title: 'Ingeniería en Sistemas de Información',
        description: 'Universidad Tecnológica Nacional (UTN FRC) — en curso.',
        icon: 'tabler:school',
      },
      {
        title: 'Administrador de Redes de Computadoras',
        description: 'Universidad Tecnológica Nacional (UTN FRC) — 2015.',
        icon: 'tabler:certificate',
      },
      {
        title: 'Diplomatura en Gestión de Negocios',
        description: 'Universidad Siglo 21 — en curso.',
        icon: 'tabler:template',
      },
      {
        title: 'Ciencias de la Computación e Información',
        description: 'Universidad Johann Wolfgang Goethe, Alemania (2001–2007).',
        icon: 'tabler:school',
      },
      {
        title: 'Cursos Platzi',
        description:
          'Fundamentos de Project Management (2025), Introducción a AWS (2023), Administración de Servidores Linux (2022), Fundamentos de Ingeniería de Software (2022), entre otros.',
        icon: 'tabler:certificate',
      },
      {
        title: 'Idiomas',
        description: 'Español nativo, alemán fluido, portugués fluido, inglés B2.',
        icon: 'tabler:language',
      },
    ]}
  />

  {/* CONTACTO */}
  <CallToAction
    id="contacto"
    title="¿Charlamos?"
    subtitle="El contacto es a través de LinkedIn o GitHub."
    actions={[
      {
        variant: 'primary',
        text: 'LinkedIn',
        href: 'https://www.linkedin.com/in/martinlescano/',
        target: '_blank',
        icon: 'tabler:brand-linkedin',
      },
      {
        variant: 'secondary',
        text: 'GitHub',
        href: 'https://github.com/mlescano',
        target: '_blank',
        icon: 'tabler:brand-github',
      },
    ]}
  />
</Layout>
