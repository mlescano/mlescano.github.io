---
import Layout from '~/layouts/PageLayout.astro';
import Image from '~/components/common/Image.astro';

import { findLatestPosts } from '~/utils/blog';
import { findImage } from '~/utils/images';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Martín Lescano | Responsable de Área de TI',
  ignoreTitleTemplate: true,
};

const aboutCards = [
  {
    title: 'Infraestructura y virtualización',
    desc: 'Diseñé e implementé la plataforma propia sobre Proxmox VE y Ceph, en reemplazo de VMware ESXi: compra de hardware, diseño de VLAN y conectividad entre nodos, y definición de servicios con alta disponibilidad.',
    icon: 'rack',
  },
  {
    title: 'Backup y continuidad operativa',
    desc: 'Estrategia de backup y recuperación ante desastres con Veeam B&R y Proxmox Backup Server con réplica off-site, reduciendo de forma estimada el tiempo de restauración de ~22 horas a menos de 4 horas.',
    icon: 'shield',
  },
  {
    title: 'Automatización con criterio determinista',
    desc: 'Desarrollo, con asistencia de IA, aplicaciones y automatizaciones para procesos de soporte. Uso soluciones deterministas, e IA solo donde aporta valor.',
    icon: 'gear',
  },
];

const stats = [
  { num: '5+', label: 'Años en Sohipren S.A.' },
  { num: '86%', label: 'Reducción de costos de infraestructura' },
  { num: '50+', label: 'VMs migradas a Proxmox + Ceph' },
  { num: '40+', label: 'Proyectos ejecutados (2021–2026)' },
];

const stackCategories = ['Todo', 'Infraestructura', 'Redes', 'Sistemas', 'Soporte'];
const stack = [
  { name: 'Proxmox VE', cat: 'Infraestructura', abbr: 'PX' },
  { name: 'Ceph', cat: 'Infraestructura', abbr: 'CE' },
  { name: 'Proxmox Backup Server', cat: 'Infraestructura', abbr: 'PB' },
  { name: 'Veeam B&R', cat: 'Infraestructura', abbr: 'VB' },
  { name: 'Docker Swarm', cat: 'Infraestructura', abbr: 'DK' },
  { name: 'Mikrotik', cat: 'Redes', abbr: 'MK' },
  { name: 'Ubiquiti UniFi', cat: 'Redes', abbr: 'UF' },
  { name: 'Issabel 5 (VoIP)', cat: 'Redes', abbr: 'IS' },
  { name: 'Starlink', cat: 'Redes', abbr: 'ST' },
  { name: 'Active Directory', cat: 'Sistemas', abbr: 'AD' },
  { name: 'GPO', cat: 'Sistemas', abbr: 'GP' },
  { name: 'GLPI', cat: 'Soporte', abbr: 'GL' },
  { name: 'MeshCentral', cat: 'Soporte', abbr: 'MC' },
  { name: 'USMT', cat: 'Soporte', abbr: 'US' },
];

const timeline = [
  {
    year: '2021',
    short: '01',
    status: 'Completado',
    items: [
      'Actualización de S.O.',
      'Infraestructura',
      'Microservicios',
      'Migración de dominio',
      'Políticas de backup',
      'Red profesional',
      'Seguridad del router',
      'UPS para servidores',
      'Veeam B&R',
    ],
  },
  {
    year: '2022',
    short: '02',
    status: 'Completado',
    items: [
      'Antivirus',
      'Banco de pruebas',
      'Migración de SQL',
      'Nuevo router',
      'Red del galpón',
      'RemoteApp',
      'Seguridad de Gmail',
      'Desarrollo de scripts',
    ],
  },
  {
    year: '2023',
    short: '03',
    status: 'Completado',
    items: [
      'Docker Swarm',
      'GPO',
      'Red de fibra',
      'Seguridad contra dispositivos desconocidos',
      'Seguridad SSL',
      'UPS grabado',
    ],
  },
  {
    year: '2024',
    short: '04',
    status: 'Completado',
    items: [
      'Infraestructura Proxmox',
      'Proxmox Backup',
      'Aire acondicionado',
      'UPS para PCs críticas',
      'Internet satelital Starlink',
      'Telefonía VoIP',
      'Desarrollo de scripts',
      'Planificación',
      'Capacitación en ciberseguridad',
    ],
  },
  {
    year: '2025',
    short: '05',
    status: 'Completado',
    items: ['Monitoreo de servidores críticos', 'Migración de más de 50 VMs de servidores ESXi a Proxmox'],
  },
  {
    year: '2026',
    short: '06',
    status: 'En curso',
    items: [
      'Instalación de VoIP con Issabel 5',
      'Instalación de Minio',
      'Instalación de Nextcloud',
      'Digitalización de documentos de armado y prueba',
      'Estabilización de infraestructura',
      'Modernización de infraestructura',
      'Gestión de programas de CNC',
      'Mejora de Wi-Fi',
      'App de soporte remoto',
      'Servicio de despliegue automático de PCs',
    ],
  },
];

const experiencia = [
  {
    empresa: 'Sila Holding Industriale',
    cargo: 'IT Manager',
    anios: '2008–2009 y 2015–2016',
    desc: 'Reportando a la dirección. Ahorro del 60% en costos de IT. Coordiné la implementación del ERP Protheus V.8 con Totvs.',
  },
  {
    empresa: 'ML Services & GFG Informática',
    cargo: 'Owner/Partner',
    anios: '2016–2021',
    desc: 'Consultoría en virtualización VMware vSphere, redes, backup y seguridad. +30% de eficiencia y −40% de inactividad para clientes.',
  },
  {
    empresa: 'Hewlett-Packard',
    cargo: 'Information Security Consultant',
    anios: '2009–2011',
    desc: 'Administración de accesos para clientes. Documentación adoptada a nivel global.',
  },
];

const formacion = [
  {
    titulo: 'Ingeniería en Sistemas de Información',
    institucion: 'Universidad Tecnológica Nacional (UTN FRC)',
    status: 'En curso',
  },
  { titulo: 'Diplomatura en Gestión de Negocios', institucion: 'Universidad Siglo 21', status: 'En curso' },
  {
    titulo: 'Administrador de Redes de Computadoras',
    institucion: 'Universidad Tecnológica Nacional (UTN FRC) — 2015',
    status: '',
  },
  {
    titulo: 'Ciencias de la Computación e Información',
    institucion: 'Universidad Johann Wolfgang Goethe, Alemania (2001–2007)',
    status: '',
  },
  {
    titulo: 'Cursos Platzi',
    institucion: 'Project Management, AWS, Servidores Linux, Ingeniería de Software, entre otros',
    status: '',
  },
  { titulo: 'Idiomas', institucion: 'Español nativo, alemán fluido, portugués fluido, inglés B2', status: '' },
];

const latestPosts = await findLatestPosts({ count: 4 });
const casos = await Promise.all(
  latestPosts.map(async (post) => ({
    title: post.title,
    summary: post.excerpt,
    category: typeof post.category === 'object' ? post.category?.title : post.category,
    href: getPermalink(post.permalink, 'post'),
    image: await findImage(post.image),
  }))
);
---

<Layout metadata={metadata}>
  <section class="ml-hero" id="inicio">
    <div class="ml-container">
      <div class="ml-hero-meta ml-hero-in" style="animation-delay:0ms">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          ><path d="M12 21s7-6.5 7-12a7 7 0 10-14 0c0 5.5 7 12 7 12z"></path><circle cx="12" cy="9" r="2.5"
          ></circle></svg
        >
        Córdoba, Argentina
      </div>
      <div class="ml-hero-greeting ml-hero-in" style="animation-delay:80ms">Hola, soy</div>
      <h1 class="ml-hero-in" style="animation-delay:160ms">Martín Lescano</h1>
      <div class="ml-role ml-hero-in" style="animation-delay:240ms">// Responsable de Área de TI</div>
      <p class="ml-sub ml-hero-in" style="animation-delay:320ms">
        Liderazgo técnico y estrategia en infraestructura resiliente: Proxmox, Ceph y alta disponibilidad, con un
        criterio claro de soluciones deterministas y automatización donde aporta valor real.
      </p>
      <div class="ml-hero-actions ml-hero-in" style="animation-delay:400ms">
        <a class="ml-btn ml-btn-solid" href="#proyectos">Ver casos</a>
        <a class="ml-btn ml-btn-outline" href="#contacto">Contacto</a>
      </div>
    </div>
    <div class="ml-scroll-cue">
      <span>Scroll</span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
        ><path d="M12 5v14M5 12l7 7 7-7"></path></svg
      >
    </div>
  </section>

  <section class="ml-stats">
    <div class="ml-container">
      <div class="ml-stats-grid ml-reveal" data-ml-reveal>
        {
          stats.map((s) => (
            <div class="ml-stat">
              <div class="ml-stat-num">{s.num}</div>
              <div class="ml-stat-label">{s.label}</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="ml-section" id="sobre-mi">
    <div class="ml-container">
      <div class="ml-section-head">
        <div class="ml-eyebrow">Sobre mí</div>
        <h2 class="ml-section-title">Infraestructura con criterio, no por moda</h2>
        <p class="ml-lead">
          Responsable de Área de TI en Sohipren S.A. (industria metalúrgica exportadora) desde 2021, con el objetivo
          de crecer hacia la dirección de áreas de TI.
        </p>
      </div>
      <div class="ml-grid-3 ml-reveal" data-ml-reveal>
        {
          aboutCards.map((card) => (
            <div class="ml-card">
              <div class="ml-card-icon" style={{ color: card.icon === 'shield' ? 'var(--ml-lime)' : 'var(--ml-accent)' }}>
                {card.icon === 'rack' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <rect x="3" y="4" width="18" height="6" rx="1.5" />
                    <rect x="3" y="14" width="18" height="6" rx="1.5" />
                    <path d="M7 7h.01M7 17h.01" />
                  </svg>
                )}
                {card.icon === 'shield' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <path d="M12 3l7 3v5c0 4.5-3 8-7 9-4-1-7-4.5-7-9V6l7-3z" />
                    <path d="M9 12l2 2 4-4" />
                  </svg>
                )}
                {card.icon === 'gear' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <circle cx="12" cy="12" r="3" />
                    <path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 11-2.83 2.83l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 11-4 0v-.09a1.65 1.65 0 00-1-1.51 1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 11-2.83-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H3a2 2 0 110-4h.09a1.65 1.65 0 001.51-1 1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 112.83-2.83l.06.06a1.65 1.65 0 001.82.33H9a1.65 1.65 0 001-1.51V3a2 2 0 114 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 112.83 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1H21a2 2 0 110 4h-.09a1.65 1.65 0 00-1.51 1z" />
                  </svg>
                )}
              </div>
              <h3>{card.title}</h3>
              <p>{card.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="ml-section" id="stack">
    <div class="ml-container">
      <div class="ml-section-head">
        <div class="ml-eyebrow">Stack</div>
        <h2 class="ml-section-title">Stack tecnológico</h2>
        <p class="ml-lead">Las herramientas con las que trabajo día a día.</p>
      </div>
      <div class="ml-stack-filters">
        {
          stackCategories.map((c, i) => (
            <button class:list={['ml-stack-filter', { 'is-active': i === 0 }]} data-ml-stack-filter={c} type="button">
              {c}
            </button>
          ))
        }
      </div>
      <div class="ml-stack-grid ml-reveal" data-ml-reveal>
        {
          stack.map((s) => (
            <div class="ml-stack-card" data-ml-stack-card data-ml-cat={s.cat}>
              <div class="ml-stack-badge">{s.abbr}</div>
              <div>
                <div class="ml-stack-name">{s.name}</div>
                <div class="ml-stack-cat">{s.cat}</div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="ml-section" id="evolucion">
    <div class="ml-container">
      <div class="ml-section-head">
        <div class="ml-eyebrow" style="color:var(--ml-accent)">Trayectoria</div>
        <h2 class="ml-section-title">Plan Estratégico de TI 2021–2026</h2>
        <p class="ml-lead">
          Hitos ejecutados en Sohipren S.A., sobre un plan que elaboré y vengo llevando adelante año a año.
        </p>
      </div>
      <div class="ml-timeline ml-reveal" data-ml-reveal>
        {
          timeline.map((t) => (
            <div class="ml-tl-row">
              <div class="ml-tl-dot">{t.short}</div>
              <div class="ml-tl-card">
                <div class="ml-tl-card-top">
                  <div class="ml-tl-year">{t.year}</div>
                  <span class="ml-tl-badge">{t.status}</span>
                </div>
                <ul class="ml-tl-list">
                  {t.items.map((it) => (
                    <li>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M5 13l4 4L19 7" />
                      </svg>
                      {it}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="ml-section" id="proyectos">
    <div class="ml-container">
      <div class="ml-section-head">
        <div class="ml-eyebrow">Proyectos</div>
        <h2 class="ml-section-title">Casos documentados</h2>
      </div>
      <div class="ml-case-grid ml-reveal" data-ml-reveal>
        {
          casos.map((c) => (
            <a class="ml-case-card" href={c.href}>
              <div class="ml-case-img">
                {c.image && (
                  <Image
                    src={c.image}
                    alt={c.title}
                    width={400}
                    height={225}
                    aspectRatio="16:9"
                    layout="cover"
                    loading="lazy"
                    decoding="async"
                  />
                )}
              </div>
              <div class="ml-case-body">
                <h3>{c.title}</h3>
                <p>{c.summary}</p>
                {c.category && (
                  <div class="ml-case-tags">
                    <span class="ml-case-tag">{c.category}</span>
                  </div>
                )}
              </div>
            </a>
          ))
        }
      </div>
      <a class="ml-see-all" href="/blog">
        Ver todas las publicaciones
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
          ><path d="M5 12h14M13 6l6 6-6 6"></path></svg
        >
      </a>
    </div>
  </section>

  <section class="ml-section">
    <div class="ml-container">
      <div class="ml-section-head">
        <div class="ml-eyebrow">Experiencia previa</div>
        <h2 class="ml-section-title">Antes de Sohipren</h2>
      </div>
      <div class="ml-reveal" data-ml-reveal>
        {
          experiencia.map((e) => (
            <div class="ml-exp-row">
              <div>
                <h3>{e.empresa}</h3>
                <div class="ml-exp-meta">
                  {e.cargo} · {e.anios}
                </div>
              </div>
              <p>{e.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="ml-section">
    <div class="ml-container">
      <div class="ml-section-head">
        <div class="ml-eyebrow">Formación y certificaciones</div>
        <h2 class="ml-section-title">Base académica y técnica</h2>
      </div>
      <div class="ml-grid-6 ml-reveal" data-ml-reveal>
        {
          formacion.map((f) => (
            <div class="ml-edu-card">
              <div class="ml-edu-top">
                <div class="ml-edu-icon">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M22 10L12 5 2 10l10 5 10-5z" />
                    <path d="M6 12v5c0 1.5 2.7 3 6 3s6-1.5 6-3v-5" />
                  </svg>
                </div>
                {f.status && <span class="ml-edu-badge">{f.status}</span>}
              </div>
              <h3>{f.titulo}</h3>
              <p>{f.institucion}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="ml-section" id="contacto" style="border-bottom:none">
    <div class="ml-container ml-contact-box">
      <div class="ml-eyebrow" style="justify-content:center">Contacto</div>
      <h2 style="margin-top:14px">¿Charlamos?</h2>
      <div class="ml-contact-cards ml-reveal" data-ml-reveal>
        <a class="ml-contact-card" href="https://www.linkedin.com/in/martinlescano/" target="_blank" rel="noopener">
          <span class="ml-contact-card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"
              ><path
                d="M4.98 3.5a2.5 2.5 0 11-.02 5.001A2.5 2.5 0 014.98 3.5zM3 9h4v12H3V9zm7 0h3.6v1.7h.05c.5-.95 1.75-1.95 3.6-1.95 3.85 0 4.55 2.5 4.55 5.75V21h-4v-5.6c0-1.35-.02-3.05-1.85-3.05-1.85 0-2.15 1.45-2.15 2.95V21h-4V9z"
              ></path></svg
            >
          </span>
          <span class="ml-contact-card-text">
            <span class="ml-contact-card-label">LinkedIn</span>
            <span class="ml-contact-card-value">
              Ver perfil
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                ><path d="M7 17L17 7M7 7h10v10"></path></svg
              >
            </span>
          </span>
        </a>
        <a class="ml-contact-card" href="https://github.com/mlescano" target="_blank" rel="noopener">
          <span class="ml-contact-card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"
              ><path
                d="M12 2a10 10 0 00-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.36 1.09 2.93.83.09-.65.35-1.09.64-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.6 9.6 0 015 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.35 4.69-4.58 4.94.36.31.68.92.68 1.85v2.75c0 .26.18.57.69.48A10 10 0 0012 2z"
              ></path></svg
            >
          </span>
          <span class="ml-contact-card-text">
            <span class="ml-contact-card-label">GitHub</span>
            <span class="ml-contact-card-value">
              Ver repositorios
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                ><path d="M7 17L17 7M7 7h10v10"></path></svg
              >
            </span>
          </span>
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('[data-ml-stack-filter]');
  const stackCards = document.querySelectorAll<HTMLElement>('[data-ml-stack-card]');

  filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-ml-stack-filter');
      filterButtons.forEach((b) => b.classList.toggle('is-active', b === btn));
      stackCards.forEach((card) => {
        const cat = card.getAttribute('data-ml-cat');
        card.classList.toggle('is-hidden', filter !== 'Todo' && cat !== filter);
      });
    });
  });

  const revealEls = document.querySelectorAll<HTMLElement>('[data-ml-reveal]');
  if ('IntersectionObserver' in window && revealEls.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-in');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 }
    );
    revealEls.forEach((el) => observer.observe(el));
  } else {
    revealEls.forEach((el) => el.classList.add('is-in'));
  }
</script>

<style>
  .ml-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ml-lime);
  }
  .ml-eyebrow::before {
    content: '';
    width: 16px;
    height: 1px;
    background: currentColor;
  }
  .ml-container {
    max-width: 1180px;
    margin-inline: auto;
    padding-inline: 40px;
  }
  @media (max-width: 600px) {
    .ml-container {
      padding-inline: 20px;
    }
  }
  .ml-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 26px;
    font-weight: 600;
    font-size: 14px;
    border-radius: 999px;
    cursor: pointer;
    border: 1px solid transparent;
    transition:
      transform 0.15s ease,
      opacity 0.15s ease;
  }
  .ml-btn:hover {
    transform: translateY(-2px);
  }
  .ml-btn-solid {
    background: var(--ml-lime);
    color: var(--ml-lime-text);
  }
  .ml-btn-outline {
    background: transparent;
    color: var(--aw-color-text-default);
    border-color: var(--ml-border-strong);
  }
  .ml-section {
    padding-block: 96px;
    border-bottom: 1px solid var(--ml-border);
